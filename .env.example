# Math Quest v2 — Environment Variables

# Supabase Configuration (Optional - Enable when deploying backend DB)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# LLM Proxy Configuration (Optional - Enable when activating LLM API)
VITE_ENABLE_LLM_API=false
VITE_LLM_PROXY_ENDPOINT=https://your-proxy-endpoint.vercel.app/api/tutor
